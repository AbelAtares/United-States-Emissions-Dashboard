{
  "datasets": [
    {
      "name": "df438869",
      "displayName": "Location Data",
      "queryLines": [
        "SELECT latitude,\r\n",
        "longitude,\r\n",
        "`GHG emissions mtons CO2e` as Emissions\r\n",
        "FROM   emissions.default.emissions_data"
      ]
    },
    {
      "name": "20f8a512",
      "displayName": "Emissions Per Person",
      "queryLines": [
        "SELECT county_name,\r\n",
        "population,\r\n",
        "CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) / population AS emissions_per_capita\r\n",
        "FROM   emissions.default.emissions_data\r\n",
        "ORDER BY emissions_per_capita DESC"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "45f0b1da",
      "displayName": "Total Emissions Per State",
      "queryLines": [
        "SELECT state_abbr,\r\n",
        "SUM(CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE)) AS Total_Emissions\r\n",
        "FROM   emissions.default.emissions_data\r\n",
        "GROUP BY state_abbr\r\n",
        "ORDER BY Total_Emissions DESC\r\n",
        "LIMIT 10"
      ],
      "catalog": "emissions",
      "schema": "default"
    },
    {
      "name": "caf7af69",
      "displayName": "County Shaming",
      "queryLines": [
        "SELECT\r\n",
        "  county_name,\r\n",
        "  population,\r\n",
        "  CAST(REPLACE(`GHG emissions mtons CO2e`, ',', '') AS DOUBLE) AS Total_Emissions\r\n",
        "FROM\r\n",
        "  emissions.default.emissions_data\r\n",
        "ORDER BY\r\n",
        "  Total_Emissions DESC\r\n",
        "LIMIT 10"
      ]
    }
  ],
